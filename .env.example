# Sudoo settings. Written to /opt/odoo/manager/.env by the installer, which keeps every value already set there.
# After a change: cd /opt/odoo/manager && docker compose up -d
# All settings, their types and defaults: docs/CONFIGURATION.md. Check what the panel uses: sudoo config
# Settings marked "live" there (behaviour, contact, versions) can also be changed on the panel's Settings page; those
# changes take effect at once and are kept on top of this file (Reset brings back the value here).

# ----------------------------------------------------------------------------- contact
# Who users are told to contact when something needs the administrator
ADMIN_CONTACT_NAME=the administrator
ADMIN_CONTACT_PHONE=
ADMIN_CONTACT_EMAIL=

# ----------------------------------------------------------------------------- Odoo versions
# "auto": every published x.0 version of ODOO_IMAGE on Docker Hub, from ODOO_MIN_VERSION on.
# Or a fixed list, for example: ODOO_VERSIONS=17.0,18.0,19.0
ODOO_VERSIONS=auto
ODOO_MIN_VERSION=16.0
# Docker images (the tag of ODOO_IMAGE is the Odoo version)
ODOO_IMAGE=odoo
POSTGRES_IMAGE=postgres:16
# Password of the Odoo user "admin" in new instances
ODOO_ADMIN_PASSWORD=admin

# ----------------------------------------------------------------------------- instance containers
# Limits of each instance's Odoo and database containers, applied when an instance next starts or restarts.
# Memory in Docker units (512m, 2g), processors in cores; 0 turns a limit off.
ODOO_MEMORY_LIMIT=2g
ODOO_CPU_LIMIT=2
DB_MEMORY_LIMIT=1g
DB_CPU_LIMIT=2
# Processes and threads one container may run at the same time
CONTAINER_PIDS_LIMIT=1024
# Container log rotation: size of one file, and how many files are kept
CONTAINER_LOG_MAX_SIZE=10m
CONTAINER_LOG_MAX_FILES=3
# When an instance's containers or files are changed outside the panel: warn (report it: audit log, banner, e-mail
# to super admins) or restore (report it, then recreate Odoo and its database from the panel's configuration,
# backing the database up first). Connectors are only ever reported. See docs/SECURITY.md.
DRIFT_ACTION=restore

# ----------------------------------------------------------------------------- Enterprise add-ons (plugin)
# Where the Odoo Enterprise add-ons come from: folder, git, or none (Community only). See docs/PLUGINS.md.
ENTERPRISE_SOURCE=folder
# folder: where the add-ons of a version are. {version} becomes 19.0, {major} becomes 19.
ENTERPRISE_PATH=/opt/odoo/enterprise/{version}
# git: a repository with one branch per version (give the server a deploy key for it under GitHub access).
ENTERPRISE_GIT_URL=
ENTERPRISE_GIT_BRANCH={version}
# A module that must be present for the add-ons of a version to count as available
ENTERPRISE_MARKER=web_enterprise

# ----------------------------------------------------------------------------- exposure (plugin)
# How the panel and the instances are reached from outside:
#   cloudflare-quick  free https link per instance through Cloudflare; no open port, no domain (links change
#                     when the server restarts)
#   host-ports        visitors connect to <PUBLIC_SCHEME>://<PUBLIC_HOST>:<port>; the ports must be open
EXPOSURE=cloudflare-quick
# host-ports only
PUBLIC_HOST=
PUBLIC_SCHEME=http

# ----------------------------------------------------------------------------- code updates (plugins)
# What starts a code update, comma-separated (several can work together):
#   polling          check GitHub every POLL_MINUTES; works everywhere
#   github-webhook   GitHub calls <panel address>/hooks/github on every push; needs a panel address that does not
#                    change (host-ports or your own domain) and the secret below, also entered on GitHub
UPDATE_TRIGGERS=polling
GITHUB_WEBHOOK_SECRET=

# ----------------------------------------------------------------------------- storage, sign-in, e-mail (plugins)
# The panel's own data: sqlite (/opt/odoo/manager/sudoo.db)
STORAGE=sqlite
# How passwords are checked: local (the panel's accounts)
AUTH=local
# Second factors offered at sign-in: email (needs SMTP below), totp (authenticator app)
SECOND_FACTORS=email,totp
# Who must use one: none, admins, everyone (also on the Settings page)
REQUIRE_SECOND_FACTOR=admins
# E-mail, for sign-in codes: your own mailbox, e.g. your website's no-reply address. Empty SMTP_HOST: no e-mail.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USERNAME=the address, SMTP_PASSWORD=an app password (docs/CONFIGURATION.md).
# Test: docker exec sudoo-panel sudoo.sh test-email you@example.com
MAILER=smtp
MAIL_FROM=Sudoo.sh <no-reply@your-site.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# Folder of e-mail templates replacing the built-in ones; accent colour of e-mails
MAIL_TEMPLATES_DIR=
BRAND_COLOR=#714B67

# ----------------------------------------------------------------------------- limits (also on the Settings page)
RATE_LIMITER=memory
# Requests per minute per user, API token or address; 0: no limit
RATE_LIMIT_READS_PER_MINUTE=600
RATE_LIMIT_CHANGES_PER_MINUTE=60
# Instances: on the server, per user, and minutes between two creations of one user; 0: no limit
MAX_INSTANCES=0
MAX_INSTANCES_PER_USER=0
CREATE_COOLDOWN_MINUTES=0

# ----------------------------------------------------------------------------- ports
# The panel's address: the web app (sudoo-web) listens here; the backend on API_PORT, 127.0.0.1 only
PANEL_PORT=9000
API_PORT=9002
# Live event stream (/api/v1/events), 127.0.0.1 only
EVENTS_PORT=9001
GATEWAY_PORT_START=8069
ODOO_PORT_START=28069

# ----------------------------------------------------------------------------- behaviour
# Pause an instance after this many hours without visits (0: never)
IDLE_HOURS=6
# Defaults of the automation switches of new instances (each instance can change its own)
AUTO_PAUSE=true
AUTO_UPDATE=true
AUTO_UPGRADE=true
# Lifetime offered for new instances: deleted (after a backup) this many days after creation.
# Each instance can be set to "keep" instead, when it is created or later. 0 offers "keep" by default.
DELETE_AFTER_DAYS=30
# Once a day at DAILY_BACKUP_TIME (HH:MM in TIMEZONE), back up every instance used since its last daily backup.
# Each instance keeps only its latest daily backup.
DAILY_BACKUPS=true
DAILY_BACKUP_TIME=00:00
TIMEZONE=UTC
# After a restore, the state before it is kept this many hours, and the instance offers "Rollback" meanwhile.
ROLLBACK_HOURS=24
# polling: check GitHub for new commits every this many minutes
POLL_MINUTES=2
# Panel sessions: end after this many idle minutes, and at the latest after this many hours
SESSION_IDLE_MINUTES=60
SESSION_MAX_HOURS=12
